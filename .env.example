# Copie este arquivo para .env e preencha. NUNCA commite o .env.
GEMINI_API_KEY=
# Opcional. Se omitido, usa gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite
# Opcionais (Etapa 3). Se omitidos, usam estes valores.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSAO=768
# Opcional (Etapa 9). Teto de gasto por dia em USD; 0 desliga.
ORCAMENTO_DIARIO_USD=2.0
